{
  "manifest_version": 2,
  "name": "GeorgesPaul Form Filler",
  "version": "1.28",
  "description": "Intelligently fills forms based on user profiles",
  "browser_specific_settings": {
    "gecko": {
      "id": "{7d43f771-471b-4067-86f8-21812d277fa0}",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "personallyIdentifyingInfo",
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "tabs",
    "<all_urls>",
    "http://localhost/*",
    "https://localhost/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "sidebar_action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Form Filler",
    "default_panel": "popup.html"
  },
  "background": {
    "scripts": [
      "browserCompat.js",
      "apiUtils.js",
      "lib/kdbxweb.min.js",
      "keepassClient.js",
      "background.js",
      "contextMenu.js"
    ],
    "persistent": true
  },
  "web_accessible_resources": [
    "apiUtils.js",
    "llmConfig.html",
    "llmConfig.js",
    "keepassConfig.html",
    "keepassConfig.js",
    "popup.js",
    "styles.css",
    "icons/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "pageHook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "browserCompat.js",
        "apiUtils.js",
        "utils.js",
        "accessibleName.js",
        "eventSim.js",
        "domUtils.js",
        "typingEngine.js",
        "autocompleteFiller.js",
        "choiceWidget.js",
        "dateField.js",
        "llmClient.js",
        "heuristicFiller.js",
        "overlayUtils.js",
        "formKit.js",
        "siteMemory.js",
        "fillLogger.js",
        "fillAgent.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "GeorgesPaul Form Filler",
    "default_popup": "popup.html"
  }
}
