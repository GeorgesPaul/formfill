{
  "manifest_version": 2,
  "name": "GeorgesPaul Form Filler",
  "version": "1.15",
  "description": "Intelligently fills forms based on user profiles",
  "browser_specific_settings": {
    "gecko": {
      "id": "formfiller@megahard.pro"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "<all_urls>",
    "http://localhost/*",
    "https://localhost/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "sidebar_action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Form Filler",
    "default_panel": "popup.html"
  },
  "background": {
    "scripts": [
      "apiUtils.js",
      "lib/kdbxweb.min.js",
      "keepassClient.js",
      "background.js"
    ],
    "persistent": true
  },
  "web_accessible_resources": [
    "apiUtils.js",
    "llmConfig.html",
    "llmConfig.js",
    "keepassConfig.html",
    "keepassConfig.js",
    "popup.js",
    "styles.css",
    "icons/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "apiUtils.js",
        "utils.js",
        "domUtils.js",
        "llmClient.js",
        "formFiller.js",
        "heuristicFiller.js",
        "visionFiller.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "GeorgesPaul Form Filler",
    "default_popup": "popup.html"
  }
}